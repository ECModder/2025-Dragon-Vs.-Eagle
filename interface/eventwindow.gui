#  # ### #   #  ##     ### #   # ### #  # ###  ## 
## # #   #   # #       #   #   # #   ## #  #  #   
# ## ##  # # #  #      ##   # #  ##  # ##  #   #  
#  # #   # # #   #     #    # #  #   #  #  #    # 
#  # ###  # #  ##      ###   #   ### #  #  #  ##  

	containerWindowType = {
		name = "EventWindow_News"
		position = { x=-290 y=-400 }
		# The game never resizes this window and cuts what falls outside:
		# the height must hold the longest news. 924 = 296 (top) + 462 (24
		# lines of text + 30) + 166 (3 options). Shorter texts leave room for
		# more options; nothing is drawn in the unused part.
		size = { width = 581 height = 924 }
		moveable = yes
		clipping = no
		Orientation = CENTER

		show_sound = world_news_effect
		hide_sound = menu_close_window

		# header, picture slot and title bar; it also drags the window
		background = {
			name = "Background"
			spriteType ="GFX_DVE_event_news_top"
		}

		containerWindowType = {
			name = "top_Window"
			position = { x=0 y=0 }
			size = { width = 581 height = 296 }
			Orientation = UPPER_LEFT

			iconType =
			{
				name ="event_picture"
				spriteType = "GFX_news_event_001"
				position = { x = 92 y = 70 }
				Orientation = "UPPER_LEFT"
				alwaystransparent = yes
			}

			iconType = {
				name ="event_picture_overlay"
				spriteType = "GFX_DVE_event_news_pic_overlay"
				position = { x = 91 y = 69 }
				Orientation = "UPPER_LEFT"
				alwaystransparent = yes
			}

			instantTextBoxType = {
				name = "Title"
				position = { x = 12 y = 258 }
				font = "hoi_24header"
				borderSize = {x = 0 y = 0}
				text = "Title text here!"
				maxWidth = 557
				maxHeight = 32
				format = centre
			}

			buttonType = {
				name = "btn_minimize"
				position = {x=541 y=16}
				spriteType = "GFX_DVE_event_minimize"
				clicksound = click_default
			}
		}

		# text: the game makes this section as tall as the text + 30 and
		# moves bottom_Window right under it
		containerWindowType = {
			name = "midsection"
			position = { x=0 y=296 }
			size = { width = 580 height = 60 }
			clipping = no
			Orientation = UPPER_LEFT

			background = {
				name = "Background"
				quadTextureSprite ="GFX_DVE_event_mid"
			}

			instantTextBoxType = {
				name = "Description"
				position = { x = 31 y = 4 }
				font = "hoi_18mbs"
				borderSize = {x = 0 y = 0}
				text = "Long text here!"
				maxWidth = 518
				maxHeight = 900
				format = left
			}
		}

		# options: no background, see event_option_entry
		containerWindowType = {
			name = "bottom_Window"
			position = { x=0 y=356 }
			size = { width = 581 height = 166 }
			clipping = no
			Orientation = UPPER_LEFT

			gridBoxType = {
				name = "options_grid"
				position = { x = 114 y = 0 }
				size = { width = 300 height = 30 }
				slotsize = { width = 300 height = 52 }
				max_slots_horizontal = 1
				format = "UPPER_LEFT"
			}
		}
	}
	
	# One option, shared by every event window. Besides the button, the entry
	# draws its own 581x52 strip of panel (left, around the button, right)
	# and a 10 px closing frame under it, which the next option covers: so
	# the panel ends after the last option, whatever their number.
	# options_grid must be at x = 114 with 52 px slots.
	containerWindowType = {
		name = "event_option_entry"
		size = { width = 300 height = 52 }
		clipping = no

		background = {
			name = "event_option_background"
			spriteType ="GFX_DVE_event_option"
		}

		iconType = {
			name = "option_row_left"
			spriteType = "GFX_DVE_event_option_row_left"
			position = { x = -114 y = 0 }
		}

		# panel around the button, with a hole the button shows through
		iconType = {
			name = "option_row_mid"
			spriteType = "GFX_DVE_event_option_row_mid"
			position = { x = 0 y = 0 }
			alwaystransparent = yes
		}

		iconType = {
			name = "option_row_right"
			spriteType = "GFX_DVE_event_option_row_right"
			position = { x = 352 y = 0 }
		}

		iconType = {
			name = "option_row_cap"
			spriteType = "GFX_DVE_event_option_cap"
			position = { x = -114 y = 52 }
		}

		instantTextBoxType = {
			name = "Name"
			position = { x = 5 y = 9 }
			font = "hoi_20bs"
			maxWidth = 340
			maxHeight = 40
			format = center
			vertical_alignment = center
			alwaystransparent = yes
		}
	}
}
