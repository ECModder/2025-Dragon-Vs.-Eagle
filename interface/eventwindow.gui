# DvE: the base game's eventwindow.gui with the "bluetone" skin on the
# country event window (EventWindow), the news window (EventWindow_News)
# and the option button. Sprites in interface/DVE_eventwindow.gfx.
# The operative and leader windows keep the base look (only their option
# grids are aligned with the option strip).
# Structure and element names must stay as the game expects them.
guiTypes = {

 ##   ##  #  # #  # ### ###  #   #     ### #   # ### #  # ###  ## 
#  # #  # #  # ## #  #  #  #  # #      #   #   # #   ## #  #  #   
#    #  # #  # # ##  #  ###    #       ##   # #  ##  # ##  #   #  
#  # #  # #  # #  #  #  #  #   #       #    # #  #   #  #  #    # 
 ##   ##   ##  #  #  #  #  #   #       ###   #   ### #  #  #  ##  

	containerWindowType = {
		name = "EventWindow"
		position = { x=-282 y=-380 }
		# The game sets the height itself: top_Window + midsection (stretched
		# to the text) + the declared height of bottom_Window. What falls
		# outside is cut, so bottom_Window is declared for 7 options.
		size = { width = 581 height = 830 }
		moveable = yes
		clipping = no
		Orientation = CENTER

		show_sound = event_popup
		hide_sound = menu_close_window

		# header bar, picture slot and title bar. As in the base news window
		# the art is the background of the root: it is what drags the window.
		background = {
			name = "Background"
			spriteType ="GFX_DVE_event_top_wide"
		}

		containerWindowType = {
			name = "top_Window"
			position = { x=0 y=0 }
			size = { width = 581 height = 396 }
			Orientation = UPPER_LEFT

			# NOTE: the game only looks for event_picture in bottom_Window
			# (error.log: Could not find "event_picture" in window
			# bottom_Window), so here it never gets the picture of the event.
			iconType = {
				name ="event_picture"
				spriteType = "GFX_report_event_001"
				position = { x = 133 y = 70 }
				Orientation = "UPPER_LEFT"
				scale = 1.5
				alwaystransparent = yes
			}

			# was the paper clip: now the screen overlay of the picture
			iconType = {
				name ="event_pic_clip"
				spriteType = "GFX_DVE_event_pic_overlay_wide"
				position = { x = 133 y = 70 }
				Orientation = "UPPER_LEFT"
				alwaystransparent = yes
			}

			instantTextBoxType = {
				name = "Title"
				position = { x = 24 y = 356 }
				font = "hoi_24header"
				borderSize = {x = 0 y = 0}
				text = "Title text here!"
				maxWidth = 533
				maxHeight = 30
				format = left
			}

			buttonType = {
				name = "btn_minimize"
				position = {x=541 y=16}
				spriteType = "GFX_DVE_event_minimize"
				clicksound = click_default
				pdx_tooltip = "MINIMIZE_EVENT"
			}
		}

		# description: the game makes this section as tall as the text + 30
		containerWindowType = {
			name = "midsection"
			position = { x=0 y=396 }
			size = { width = 580 height = 60 }
			clipping = no
			Orientation = UPPER_LEFT

			background = {
				name = "Background"
				quadTextureSprite ="GFX_DVE_event_mid"
			}

			instantTextBoxType = {
				name = "Description"
				position = { x = 31 y = 0 }
				font = "hoi_18mbs"
				borderSize = {x = 0 y = 0}
				text = "Long text here!"
				maxWidth = 518
				maxHeight = 900
				format = left
			}
		}

		# options: the game moves this section under the text. No background:
		# every option draws its own strip of panel (event_option_entry).
		# Height = 7 options x 52 + 10 of closing frame.
		containerWindowType = {
			name = "bottom_Window"
			position = { x=0 y=456 }
			size = { width = 581 height = 374 }
			clipping = no
			Orientation = UPPER_LEFT

			gridBoxType = {
				name = "options_grid"
				position = { x = 114 y = 0 }
				size = { width = 300 height = 30 }
				slotsize = { width = 300 height = 52 }
				max_slots_horizontal = 1
				format = "UPPER_LEFT"
			}
		}
	}


 ##  ###  ### ###   ##  ### ### #   # ###     ### #   # ### #  # ###  ## 
#  # #  # #   #  # #  #  #   #  #   # #       #   #   # #   ## #  #  #   
