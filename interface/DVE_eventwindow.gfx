# DvE - "bluetone" skin of the event windows (interface/eventwindow.gui).
# Art in gfx/interface/DVE_events/.

spriteTypes = {
	# GFX_DVE_event_top, _bottom and _pic_overlay are only used by the old
	# fallback layout (interface/eventwindow_safe_layout.txt)
	spriteType = {
		name = "GFX_DVE_event_top"
		texturefile = "gfx/interface/DVE_events/event_top.dds"
	}
	# stretched vertically to the length of the description
	corneredTileSpriteType = {
		name = "GFX_DVE_event_mid"
		size = { x = 580 y = 64 }
		textureFile = "gfx/interface/DVE_events/event_mid.dds"
		borderSize = { x = 290 y = 16 }
	}
	spriteType = {
		name = "GFX_DVE_event_bottom"
		texturefile = "gfx/interface/DVE_events/event_bottom.dds"
	}
	spriteType = {
		name = "GFX_DVE_event_pic_overlay"
		texturefile = "gfx/interface/DVE_events/event_pic_overlay.dds"
	}
	spriteType = {
		name = "GFX_DVE_event_option"
		texturefile = "gfx/interface/DVE_events/event_option.dds"
	}
	spriteType = {
		name = "GFX_DVE_event_minimize"
		texturefile = "gfx/interface/DVE_events/event_minimize.dds"
	}
	# news window: header, picture slot and title bar (background of the
	# root window); the text section reuses GFX_DVE_event_mid
	spriteType = {
		name = "GFX_DVE_event_news_top"
		texturefile = "gfx/interface/DVE_events/event_news_top.dds"
	}
	spriteType = {
		name = "GFX_DVE_event_news_pic_overlay"
		texturefile = "gfx/interface/DVE_events/event_news_pic_overlay.dds"
	}
	# country event window: header, picture slot and title bar (background
	# of the root window) and the overlay of the picture
	spriteType = {
		name = "GFX_DVE_event_top_wide"
		texturefile = "gfx/interface/DVE_events/event_top_wide.dds"
	}
	spriteType = {
		name = "GFX_DVE_event_pic_overlay_wide"
		texturefile = "gfx/interface/DVE_events/event_pic_overlay_wide.dds"
	}
	# strip of panel drawn by every option (event_option_entry): left of the
	# button, around it (with a hole for the button), right of it, and the
	# closing frame under the last option
	spriteType = {
		name = "GFX_DVE_event_option_row_left"
		texturefile = "gfx/interface/DVE_events/event_option_row_left.dds"
	}
	spriteType = {
		name = "GFX_DVE_event_option_row_mid"
		texturefile = "gfx/interface/DVE_events/event_option_row_mid.dds"
	}
	spriteType = {
		name = "GFX_DVE_event_option_row_right"
		texturefile = "gfx/interface/DVE_events/event_option_row_right.dds"
	}
	spriteType = {
		name = "GFX_DVE_event_option_cap"
		texturefile = "gfx/interface/DVE_events/event_option_cap.dds"
	}
}
