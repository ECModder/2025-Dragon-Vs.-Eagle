# DvE - The International panels (see common/scripted_guis/DVE_INTL_gui.txt).
# Backgrounds are 480 wide; the hemicycle is a 240x128 base plus 4 layers of 4 wedges, 76 frames each.

guiTypes = {

	# One member of the International: flag plus vote frame, in five sizes.
	# The flag is never scaled: a masked flag sprite ignores "scale", so each
	# size has its own sprite (82x52, 41x26, 27x17, 20x13, 14x9). Only the
	# frame is scaled.
	# Only the size that fits the number of members is shown (the *_visible
	# triggers of the scripted GUI read global.DVE_intl_flag_tier).
