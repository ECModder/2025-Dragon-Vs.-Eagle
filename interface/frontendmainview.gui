			alwaysTransparent = yes
		}
		
	}
	
	containerWindowType = {
		name = "change_background"
		size = { width = 100 height = 40 }
		position = { x = -20 y = -20 }
		Orientation = lower_right
		Origo = lower_right

		buttonType = {
			name ="change_background_button"
			# DvE: era GFX_button_238x38 con font hoi_24header a x=-206 y=-24.
			# Rimpicciolito a 148x34 con font hoi_16mbs. La x e' ricalcolata
			# perche' e' relativa al centro del contenitore: con 90 pixel di
			# larghezza in meno serve -116 per tenere il pulsante nello
			# stesso angolo in basso a destra.
			position = { x = -116 y = -20 }
			
			quadTextureSprite = "GFX_button_148x34"
			buttonText = "CHANGE_BACKGROUND"
			buttonFont = "hoi_16mbs"
			Orientation = center
		}

		containerWindowType = {
			name = "background_selection"
			size = { width = 238 height = 700 }
			position = { x = -156 y = -700 }
			margin = { top = 18 bottom = 13 left = 8}

			background = {
				name = "Background"
				quadTextureSprite ="GFX_tiled_window2_1b_border"
			}
			
			checkboxType = {
					name = "select_all_checkbox"
					position = { x = 13 y = 0 }
					quadTextureSprite ="GFX_generic_checkbox"
					buttonText = ""
					buttonFont = "Main_14_black"
					clicksound = click_checkbox
				}
			instantTextBoxType={
					position = {x = 53 y = 6 }
					name = "select_all_label"
					font = "hoi_18mbs"
					borderSize = {x = 0 y = 0}	
					maxWidth = 150
					maxHeight = 18
					text = "SELECT_ALL"	
					orientation = "UPPER_LEFT"
					format = left
					
			}
						
		containerWindowType = {
			name = "background_selection_list"
			size = { width = 230 height = 576 }
			position = { x = 0 y = 90 }
			verticalScrollbar = "right_vertical_slider"
			scroll_wheel_factor = 63
			smooth_scrolling = yes
			background = {
				name = "Background"
				quadTextureSprite ="GFX_tiled_window_transparent"
			}
			
				gridBoxType = {
					position = { x = 9 y = 0 }
					name = "available_backgrounds"
					size = { width = 200 height = 0 }
					slotsize = { width = 200 height = 150 }
					max_slots_horizontal = 1		
				}

			}
		}
	}

