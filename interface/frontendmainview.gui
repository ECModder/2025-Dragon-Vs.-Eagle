	### SINGLE PLAYER MENU
	containerWindowType = {
		name = "mainmenu_single_player"
		# DvE: il sotto-menu (Continue / New Game / Load / Tutorial /
		# Back) era centrato come lo era il menu principale. Stessa
		# larghezza, 320, quindi stessa x: centro a 200 = 40 pixel di
		# margine dal bordo. Cosi' si apre esattamente dove stava il
		# menu da cui arrivi, invece di saltare al centro dello schermo.
		# DvE: centrato sulla stessa area del pannello principale.
		# Quello e' alto 450 col fondo a -40, quindi il suo centro sta
		# a -265 dal fondo. Questo e' alto 395: perche' i due centri
		# coincidano il suo fondo va a -265 + 395/2 = -68.
		position = { x=40 y =-68}
		size = { width = 320 height = 395}
		Orientation = lower_left
		Origo = lower_left	
				
		background = {
			name = "Background"		
			quadTextureSprite ="GFX_tiled_window"
		}
		
		ButtonType = {
			name = "sp_continue_button"
			position = { x = 16 y = 18 }
			quadTextureSprite ="GFX_main_lobby_button"	
			buttonText = "FE_CONTINUE"
			buttonFont = "hoi_24header"
			clicksound = click_default
			oversound = ui_menu_over
		}
		
		iconType = {
			name = "sp_continue_flag_left"
			quadTextureSprite ="GFX_flag_small2_not_masked"
			position = { x= 35 y = 22 }
			Orientation = "UPPER_LEFT"
			alwaystransparent = yes
		}
		
		iconType = {
			name = "sp_continue_flag_left_overlay"
			quadTextureSprite ="GFX_flag_small2_not_masked"
			position = { x= 35 y = 22 }
			Orientation = "UPPER_LEFT"
			alwaystransparent = yes
		}
		
		iconType = {
			name = "sp_continue_flag_right"
			quadTextureSprite ="GFX_flag_small2_not_masked"
			position = { x= 245 y = 22 }
			Orientation = "UPPER_LEFT"
			alwaystransparent = yes
		}
		
		iconType = {
			name = "sp_continue_flag_right_overlay"
			quadTextureSprite ="GFX_flag_small2_not_masked"
			position = { x= 245 y = 22 }
			Orientation = "UPPER_LEFT"
			alwaystransparent = yes
		}
		
		ButtonType = {
			name = "sp_new_button"
			position = { x = 16 y = 58 }
			quadTextureSprite ="GFX_main_lobby_button"	
			buttonText = "FE_NEW"
			buttonFont = "hoi_24header"
			clicksound = click_default
			oversound = ui_menu_over
		}
		
		ButtonType = {
			name = "sp_load_button"
			position = {  x = 16 y = 98 }
			quadTextureSprite ="GFX_main_lobby_button"	
			buttonText = "MENU_BAR_LOAD"
			buttonFont = "hoi_24header"
			clicksound = click_default
			oversound = ui_menu_over
		}
		
		ButtonType = {
			name = "sp_tutorial_button"
			position = { x = 16 y = 138}
			quadTextureSprite ="GFX_main_lobby_button"	
			buttonText = "FE_TUTORIAL"
			buttonFont = "hoi_24header"
			clicksound = click_default
			oversound = ui_menu_over
		}
		
		ButtonType = {
			name = "sp_back_button"
			position = { x = 16 y = 218 }
			quadTextureSprite ="GFX_main_lobby_button"	
			buttonText = "BACK"
			buttonFont = "hoi_24header"
			clicksound = click_close
			oversound = ui_menu_over
			shortcut = "ESCAPE"
		}
	}

	### MAIN MENU PANEL (bottom)
	containerWindowType = {
		name ="mainmenu_panel_bottom"

		# DvE: la colonna dei pulsanti era centrata sullo schermo
		#   (Orientation = CENTER, position x = 0).
		# Ora e' ancorata al bordo sinistro a meta' altezza:
		#   center_left aggancia al bordo sinistro, Origo = center dice
		#   che il pannello ci va col suo centro, quindi con larghezza
		#   320 la x del centro e' 40 + 160 = 200 e restano 40 pixel
		#   di margine dal bordo. Per staccarla di piu', alza la x.
		# DvE: ancorata all'angolo in basso a sinistra.
		# Origo = lower_left mette l'angolo del pannello sull'angolo
		# dello schermo, quindi x=40 e y=-40 sono proprio i 40 pixel
		# di margine da sinistra e dal fondo.
		position = { x=40 y =-40}
		size = { width = 320 height = 450 }
		Orientation = lower_left
		Origo = lower_left		

		positionType = {
			name = "subscription_size"
			position = { x = 320 y = 575 }
		}
				
		background = {
			name = "Background"		
			quadTextureSprite ="GFX_tiled_window"
