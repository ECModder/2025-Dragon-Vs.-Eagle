# DvE super events - window art, in gfx/interface/DVE_superevents/.
# "Bluetone" design: frame 620x650, one 592x320 picture per event side by
# side in superevent_images.dds, and the slanted button.

spriteTypes = {
	spriteType = {
		name = "GFX_DVE_superevent_frame"
		texturefile = "gfx/interface/DVE_superevents/superevent_frame.dds"
	}
	spriteType = {
		name = "GFX_DVE_superevent_button"
		texturefile = "gfx/interface/DVE_superevents/superevent_button.dds"
	}
	spriteType = {
		name = "GFX_DVE_superevent_images"
		texturefile = "gfx/interface/DVE_superevents/superevent_images.dds"
		noOfFrames = 4
	}
}
