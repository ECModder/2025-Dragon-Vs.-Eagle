# DvE - US presidential race: decision banner and the electoral map window.
# The scripted gui (common/scripted_guis/DVE_USA_race_scripted_gui.txt) only supplies frames (colours) and the marker position.
guiTypes = {

	# ---- decision banner (480x236 panel) ----
	containerWindowType = {
		name = "DVE_USA_race_banner_window"
		position = { x = 0 y = 0 }
		size = { width = 100% height = 236 }
		iconType = { name = "usa_banner_bg" spriteType = "GFX_USA_race_panel" position = { x = -240 y = 0 } orientation = "CENTER_UP" }
		instantTextBoxType = { name = "usa_banner_title" position = { x = -220 y = 13 } orientation = "CENTER_UP" font = "hoi_20b" text = "USA_BANNER_TITLE" format = center maxWidth = 440 maxHeight = 24 }
		instantTextBoxType = { name = "usa_banner_phase" position = { x = -220 y = 47 } orientation = "CENTER_UP" font = "hoi_16mbs" text = "USA_BANNER_PHASE" format = center maxWidth = 440 maxHeight = 20 }
