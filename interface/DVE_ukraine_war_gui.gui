# ============================================================
#   DvE - il pannello della guerra d'Ucraina
#
#   Si aggancia in cima alle due categorie di decisioni, come fa
#   il gioco base con la guerra italo-etiope
#   (interface/war_escalation_scripted_gui.gui).
#
#   Ogni obiettivo ha due icone sovrapposte nella stessa
#   posizione: quella verde e quella rossa. Quale si vede lo
#   decidono i trigger in
#   common/scripted_guis/DVE_ukraine_war_gui.txt.
# ============================================================

@RIGA1 = 46
@RIGA2 = 66
@RIGA3 = 86
@SPUNTA_X = 14
@TESTO_X = 34

