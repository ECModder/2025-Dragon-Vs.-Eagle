# DvE super events - their songs. One empty, invisible window per super
# event; it is shown together with the super event window (see
# common/scripted_guis/DVE_superevent_sounds_gui.txt) and its show_sound
# starts the song as a sound effect, so it plays even when the music
# playlist is stopped or the music volume is low.
# Sounds in sound/dve_superevents/dve_superevents_sounds.asset.

guiTypes = {
	containerWindowType = {
		name = "DVE_superevent_sound_1_window"
		position = { x = 0 y = 0 }
		size = { width = 1 height = 1 }
		show_sound = dve_se_int_victory
	}
	containerWindowType = {
		name = "DVE_superevent_sound_2_window"
		position = { x = 0 y = 0 }
		size = { width = 1 height = 1 }
		show_sound = dve_se_srb_victory
	}
	containerWindowType = {
		name = "DVE_superevent_sound_3_window"
		position = { x = 0 y = 0 }
		size = { width = 1 height = 1 }
		show_sound = dve_se_sov_victory
	}
	containerWindowType = {
		name = "DVE_superevent_sound_4_window"
		position = { x = 0 y = 0 }
		size = { width = 1 height = 1 }
		show_sound = dve_se_rca_victory
	}
	containerWindowType = {
		name = "DVE_superevent_sound_5_window"
		position = { x = 0 y = 0 }
		size = { width = 1 height = 1 }
		show_sound = dve_se_rom_revolution
	}
}
