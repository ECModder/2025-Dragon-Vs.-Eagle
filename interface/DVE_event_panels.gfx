# DvE - pictures of the events shown in the news window.
#
# The game puts the event picture on top only in the news window, so every
# event that wants the big picture is a news_event (it can be sent to one
# country only), and its picture is a "panel": header bar with the label of
# the event + the 557x372 picture, 581x436 in all. Build one with
#   python3 tools/dve_event_panel.py picture.png "HEADER TEXT" out.dds
# and add the sprite here.

spriteTypes = {
	# header only, empty screen: also stands in for the base game pictures
	# that the mod's news events still name
	spriteType = {
